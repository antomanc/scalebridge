        "decoder": "xiaomi_mi_scale_2",
        "weight_kg": 74.85,
        "stable": false,
        "complete": false,
        "load_removed": false,
        "impedance_ohm": null
      },
      "source": "captured XMTZC04HM, weight bytes changed"
    },
