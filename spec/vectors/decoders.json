{
  "$comment": "Decoder test vectors. service: 16-bit BLE service UUID (hex) the payload was advertised under. payload: service data (hex). expect: null if it must not decode. weight_kg is compared with 0.01 tolerance. Every implementation (Python package, ESP32 firmware) must pass these. scale_clock: the scale's own timestamp bytes as hex (Mi Scale 2: bytes 3-9), compared as a big-endian integer; null when the decoder does not report it. It is not a usable date (the clock is rarely set), but it changes with every new measurement, so it identifies one.",
  "cases": [
    {
      "name": "mi scale 2: idle broadcast",
      "service": "181d",
      "payload": "00000000000000000000",
      "expect": null,
      "source": "captured"
    },
    {
      "name": "mi scale 2: settling",
      "service": "181d",
      "payload": "027a3ab2070101000724",
      "expect": {
        "decoder": "xiaomi_mi_scale_2",
        "weight_kg": 74.85,
        "stable": false,
        "complete": false,
        "load_removed": false,
        "impedance_ohm": null,
        "scale_clock": "b2070101000724"
      },
      "source": "captured XMTZC04HM, weight bytes changed"
    },
    {
      "name": "mi scale 2: settling 2",
      "service": "181d",
      "payload": "02b63ab2070101000725",
      "expect": {
        "decoder": "xiaomi_mi_scale_2",
        "weight_kg": 75.15,
        "stable": false,
        "complete": false,
        "load_removed": false,
        "impedance_ohm": null,
        "scale_clock": "b2070101000725"
      },
      "source": "captured XMTZC04HM, weight bytes changed"
    },
    {
      "name": "mi scale 2: stable",
      "service": "181d",
      "payload": "22ac3ab2070101000726",
